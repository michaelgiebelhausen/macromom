# MacroMom — public app environment (inlined into the JS bundle at build time).
# Copy to .env and fill in real values. Secrets (service-role key, OpenRouter,
# Resend, RevenueCat webhook auth) live ONLY in Supabase function secrets — never here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_key
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
